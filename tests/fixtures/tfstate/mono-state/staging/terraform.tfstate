{
  "version": 4,
  "terraform_version": "1.6.6",
  "serial": 9,
  "lineage": "55555555-5555-5555-5555-555555555555",
  "outputs": {},
  "resources": [
    {
      "mode": "managed",
      "type": "aws_lb",
      "name": "public",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "arn": "arn:aws:elasticloadbalancing:eu-central-1:123456789012:loadbalancer/app/alb-staging/ffff6666gggg7777",
            "name": "alb-staging",
            "internal": false,
            "load_balancer_type": "application",
            "dns_name": "alb-staging-987654321.eu-central-1.elb.amazonaws.com",
            "access_logs": [
              { "bucket": "acme-alb-logs-staging", "enabled": true, "prefix": "alb" }
            ],
            "tags": { "env": "staging", "service": "edge" }
          },
          "dependencies": []
        }
      ]
    },
    {
      "mode": "managed",
      "type": "aws_lb_target_group",
      "name": "api",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "arn": "arn:aws:elasticloadbalancing:eu-central-1:123456789012:targetgroup/tg-api-staging/hhhh8888iiii9999",
            "name": "tg-api-staging",
            "target_type": "lambda",
            "tags": { "env": "staging", "service": "api" }
          },
          "dependencies": []
        }
      ]
    },
    {
      "mode": "managed",
      "type": "aws_lb_listener",
      "name": "https",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "arn": "arn:aws:elasticloadbalancing:eu-central-1:123456789012:listener/app/alb-staging/ffff6666gggg7777/jjjj0000",
            "load_balancer_arn": "arn:aws:elasticloadbalancing:eu-central-1:123456789012:loadbalancer/app/alb-staging/ffff6666gggg7777",
            "port": 443,
            "protocol": "HTTPS",
            "default_action": [
              {
                "type": "forward",
                "target_group_arn": "arn:aws:elasticloadbalancing:eu-central-1:123456789012:targetgroup/tg-api-staging/hhhh8888iiii9999"
              }
            ]
          },
          "dependencies": ["aws_lb.public", "aws_lb_target_group.api"]
        }
      ]
    },
    {
      "mode": "managed",
      "type": "aws_lambda_function",
      "name": "api",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "arn": "arn:aws:lambda:eu-central-1:123456789012:function:api-staging",
            "function_name": "api-staging",
            "runtime": "python3.12",
            "timeout": 30,
            "logging_config": [
              { "log_format": "Text", "log_group": "/aws/lambda/api-staging" }
            ],
            "tags": { "env": "staging", "service": "api" }
          },
          "dependencies": []
        }
      ]
    },
    {
      "mode": "managed",
      "type": "aws_cloudwatch_log_group",
      "name": "api",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "arn": "arn:aws:logs:eu-central-1:123456789012:log-group:/aws/lambda/api-staging",
            "name": "/aws/lambda/api-staging",
            "retention_in_days": 7,
            "tags": { "env": "staging", "service": "api" }
          },
          "dependencies": []
        }
      ]
    },
    {
      "mode": "managed",
      "type": "aws_glue_catalog_table",
      "name": "alb_logs",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "arn": "arn:aws:glue:eu-central-1:123456789012:table/logs_staging/alb_logs",
            "name": "alb_logs",
            "database_name": "logs_staging",
            "table_type": "EXTERNAL_TABLE",
            "parameters": { "classification": "csv", "log_type": "alb" },
            "storage_descriptor": [
              { "location": "s3://acme-alb-logs-staging/alb/AWSLogs/123456789012/elasticloadbalancing/" }
            ],
            "partition_keys": [ { "name": "day", "type": "string" } ]
          },
          "dependencies": []
        }
      ]
    }
  ]
}
