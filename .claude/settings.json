{
  "permissions": {
    "deny": [
      "Edit(.claude/**)",
      "Write(.claude/**)",
      "Edit(iam/**)",
      "Write(iam/**)",
      "Edit(CODEOWNERS)",
      "Write(CODEOWNERS)",
      "Edit(scripts/guardrails.sh)",
      "Write(scripts/guardrails.sh)",
      "Edit(.github/workflows/guardrails.yml)",
      "Write(.github/workflows/guardrails.yml)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(~/.aws/**)",
      "Bash(aws *)",
      "Bash(terraform *)",
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(doas *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(docker login*)",
      "Bash(gh secret *)",
      "Bash(gh auth *)",
      "Bash(git push --force*)",
      "Bash(git config *hooksPath*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(docker *)",
      "Bash(pip *)",
      "Bash(uv *)",
      "Bash(npm *)",
      "WebFetch",
      "WebSearch"
    ],
    "allow": [
      "Bash(make *)",
      "Bash(pytest*)",
      "Bash(python -m pytest*)",
      "Bash(ruff*)",
      "Bash(mypy*)",
      "Bash(pre-commit *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git add *)",
      "Bash(git commit*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git branch*)",
      "Bash(git restore*)",
      "Bash(ls*)",
      "Bash(cat src/*)",
      "Bash(cat tests/*)",
      "Bash(grep*)",
      "Bash(rg*)",
      "Bash(find src*)",
      "Bash(find tests*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre_tool_guard.py\""
          }
        ]
      }
    ]
  }
}
